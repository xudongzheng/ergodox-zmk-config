#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define LAYER_MAIN 0
#define LAYER_FN 1
#define LAYER_SYMBOL 2
#define LAYER_NMPAD 3

&sk {
	quick-release;
};

/ {
	keymap {
		compatible = "zmk,keymap";

		layer_0 {
			display-name = "main";
			bindings = <
				&bootloader
				&none            &kp NUMBER_1 &kp NUMBER_2 &kp NUMBER_3   &kp NUMBER_4   &kp NUMBER_5     &kp PRINTSCREEN   &none           &kp NUMBER_6 &kp NUMBER_7   &kp NUMBER_8    &kp NUMBER_9 &kp NUMBER_0  &bootloader
				&kp TAB          &kp Q        &kp W        &kp F          &kp P          &kp G            &kp CAPSLOCK      &kp C_MUTE      &kp J        &kp L          &kp U           &kp Y        &kp SEMICOLON &rgb_ug RGB_COLOR_HSB(0,100,0)
				&kp ESCAPE       &kp A        &kp R        &kp S          &kp T          &kp D                                              &kp H        &kp N          &kp E           &kp I        &kp O         &rgb_ug RGB_COLOR_HSB(120,100,20)
				&mo LAYER_SYMBOL &kp Z        &kp X        &kp C          &kp V          &kp B            &kp C_VOLUME_DOWN &kp C_VOLUME_UP &kp K        &kp M          &kp COMMA       &kp PERIOD   &kp SLASH     &rgb_ug RGB_COLOR_HSB(240,100,20)
				&none            &none        &sk LEFT_ALT &kp LEFT_ARROW &kp UP_ARROW                                                                   &kp DOWN_ARROW &kp RIGHT_ARROW &sk LEFT_ALT &none         &rgb_ug RGB_COLOR_HSB(0,100,20)
				                                                                         &none            &none             &none           &none
				                                                          &sk LEFT_SHIFT &sk LEFT_CONTROL &none             &none           &kp SPACE    &sk LEFT_GUI
				                                                                                          &kp RETURN        &mo LAYER_FN
			>;
		};

		layer_1 {
			display-name = "fn";
			bindings = <
				&bootloader
				&none        &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none &none &none &none   &none   &none   &none   &bootloader
				&out OUT_USB &kp F1       &kp F2       &kp F3       &kp F4       &kp DELETE   &none &none &none &kp F13 &kp F14 &kp F15 &kp F16 &none
				&out OUT_BLE &kp F5       &kp F6       &kp F7       &kp F8       &kp INSERT               &none &kp F17 &kp F18 &kp F19 &kp F20 &none
				&none        &kp F9       &kp F10      &kp F11      &kp F12      &none        &none &none &none &kp F21 &kp F22 &kp F23 &kp F24 &bt BT_CLR
				&none        &none        &none        &none        &none                                       &none   &none   &none   &none   &none
				                                                                 &none        &none &none &none
				                                                    &none        &none        &none &none &none &none
				                                                                              &none &none
			>;
		};

		layer_2 {
			display-name = "symb";
			bindings = <
				&bootloader
				&none &none         &none            &none            &none             &none       &none          &none            &none                &none                 &none          &none          &none           &none
				&none &none         &kp RA(NUMBER_1) &m_544b5f88      &m_929650b5       &kp HASH    &kp C_POWER    &kp C_PLAY_PAUSE &m_7fb0c2fd          &m_864363b7           &m_30985b65    &none          &none           &m_052e2647
				&none &m_123dfe8a   &kp EXCLAMATION  &kp PLUS         &kp EQUAL         &kp DOLLAR                                  &kp AMPERSAND        &m_00901bbf           &m_2d63f187    &m_8ac914cc    &m_751ccd60     &m_50d27955
				&none &kp RA(SLASH) &kp AT_SIGN      &kp LEFT_BRACKET &kp RIGHT_BRACKET &kp PERCENT &kp C_PREVIOUS &kp C_NEXT       &kp ASTERISK         &kp MINUS             &kp UNDERSCORE &kp LEFT_BRACE &kp RIGHT_BRACE &none
				&none &none         &none            &kp HOME         &kp PAGE_UP                                                                        &kp PAGE_DOWN         &kp END        &sk RIGHT_ALT  &none           &none
				                                                                        &none       &none          &none            &none
				                                                      &m_9c1ba69c       &m_9e4eb848 &none          &none            &kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS
				                                                                                    &none          &none
			>;
		};

		layer_3 {
			display-name = "nmpad";
			bindings = <
				&bootloader
				&none   &none     &none        &none          &none          &none            &none                &none                &none     &none          &none           &none        &none        &none
				&kp TAB &none     &none        &none          &none          &none            &none                &none                &none     &kp NUMBER_1   &kp NUMBER_2    &kp NUMBER_3 &none        &none
				&none   &kp SLASH &kp ASTERISK &kp MINUS      &kp PLUS       &none                                                      &none     &kp NUMBER_4   &kp NUMBER_5    &kp NUMBER_6 &kp NUMBER_0 &kp BACKSPACE
				&none   &none     &none        &none          &kp PERIOD     &none            &kp C_BRIGHTNESS_DEC &kp C_BRIGHTNESS_INC &none     &kp NUMBER_7   &kp NUMBER_8    &kp NUMBER_9 &none        &none
				&none   &none     &sk LEFT_ALT &kp LEFT_ARROW &kp UP_ARROW                                                                        &kp DOWN_ARROW &kp RIGHT_ARROW &sk LEFT_ALT &none        &to LAYER_MAIN
				                                                             &none            &none                &none                &none
				                                              &sk LEFT_SHIFT &sk LEFT_CONTROL &none                &none                &kp SPACE &sk LEFT_GUI
				                                                                              &kp RETURN           &none
			>;
		};
	};

	ZMK_MACRO(m_123dfe8a, wait-ms = <10>; tap-ms = <10>; bindings = <&macro_tap &kp SINGLE_QUOTE &kp A>;)
	ZMK_MACRO(m_2d63f187, wait-ms = <10>; tap-ms = <10>; bindings = <&macro_tap &kp SINGLE_QUOTE &kp E>;)
	ZMK_MACRO(m_50d27955, wait-ms = <10>; tap-ms = <10>; bindings = <&macro_tap &kp ASTERISK &kp ASTERISK>;)
	ZMK_MACRO(m_751ccd60, wait-ms = <10>; tap-ms = <10>; bindings = <&macro_tap &kp SINGLE_QUOTE &kp O>;)
	ZMK_MACRO(m_9c1ba69c, wait-ms = <10>; tap-ms = <10>; bindings = <&macro_tap &kp SINGLE_QUOTE &kp SPACE>;)
	ZMK_MACRO(m_9e4eb848, wait-ms = <10>; tap-ms = <10>; bindings = <&macro_tap &kp DOUBLE_QUOTES &kp SPACE>;)
	ZMK_MACRO(m_929650b5, wait-ms = <10>; tap-ms = <10>; bindings = <&macro_tap &kp GRAVE &kp SPACE>;)
	ZMK_MACRO(m_30985b65, wait-ms = <10>; tap-ms = <10>; bindings = <&macro_tap &kp SINGLE_QUOTE &kp U>;)
	ZMK_MACRO(m_8ac914cc, wait-ms = <10>; tap-ms = <10>; bindings = <&macro_tap &kp SINGLE_QUOTE &kp I>;)
	ZMK_MACRO(m_052e2647, wait-ms = <10>; tap-ms = <10>; bindings = <&macro_tap &kp GRAVE &kp GRAVE &kp GRAVE &kp SPACE>;)
	ZMK_MACRO(m_544b5f88, wait-ms = <10>; tap-ms = <10>; bindings = <&macro_tap &kp TILDE &kp SPACE>;)
	ZMK_MACRO(m_7fb0c2fd, wait-ms = <10>; tap-ms = <10>; bindings = <&macro_tap &kp CARET &kp SPACE>;)
	ZMK_MACRO(m_864363b7, wait-ms = <10>; tap-ms = <10>; bindings = <&macro_tap &kp DOUBLE_QUOTES &kp U>;)
	ZMK_MACRO(m_00901bbf, wait-ms = <10>; tap-ms = <10>; bindings = <&macro_tap &kp TILDE &kp N>;)
};
